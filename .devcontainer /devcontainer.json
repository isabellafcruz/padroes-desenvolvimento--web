{
  // definicao do nome container 
  "name": "Projeto",

  // Indica como a imagem sera criada 
  "build": {
    "dockerfile": "Dockerfile"
  },

  
  "forwardPorts": [8080, 3306],

  // Efetua personalizacoe no vs-code 
  "customizations": {  
    "vscode": {
      //Define as extensoes que serao instaladas
      "extensions": [
        "ms-azuretools.vscode-docker",    //docker     
        "vscjava.vscode-java-pack",  //java          
        "vmware.vscode-spring-boot",  //Springboot (configurador de projeto)       
        "vscjava.vscode-spring-boot-dashboard", //Dashboard do app 
        "cweijan.vscode-mysql-client2",  //mysql     
        "vscjava.vscode-spring-initializr"
      ],

      //Configuracoes visuais do vscode 
      "settings": {
        "workbench.colorTheme": "Dark Modern", //tema 
        "editor.fontSize": 14 , //Fonte do editor 
        "terminal.integrated.fontSize": 14, //Fonte do terminal 
        "java.server.launchMode": "Standard" //Fornça o java a iniciar no modo padrao 
      }
    }
  },

  //Excuta na criacao do container
  //Configura o mysql 
  "postCreateCommand": "/bin/bash .devcontainer/init-mysql.sh",

  //Executa toda vez que o cpontainer é executado 
  //Inicia o mysql
  "postStartCommand": "service mysql start"
}
